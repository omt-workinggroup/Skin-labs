{
 "cleanUrls": true,
 "trailingSlash": true,
 "headers": [
  {
   "source": "/print/(singles|packs)/(.*)",
   "headers": [
    {
     "key": "Content-Disposition",
     "value": "attachment"
    },
    {
     "key": "Cache-Control",
     "value": "public, max-age=86400"
    }
   ]
  },
  {
   "source": "/(atlas|sheets|sheets-sm|sheets-xs|inspo|skins|laptops|laptops-real|hd|fonts)/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-store"
    },
    {
     "key": "X-Robots-Tag",
     "value": "noindex"
    }
   ]
  },
  {
   "source": "/(.*)\\.([0-9a-f]{8})\\.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/(og.jpg|favicon.png|apple-touch-icon.png)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=86400"
    }
   ]
  },
  {
   "source": "/(atlas|sheets|sheets-sm|sheets-xs|inspo|skins|laptops|vendor)/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/o/:id/",
   "destination": "/api/o?id=:id"
  },
  {
   "source": "/o/:id",
   "destination": "/api/o?id=:id"
  }
 ]
}